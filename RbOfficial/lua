--// Buttons
local function createButton(text, y)
	local button = Instance.new("TextButton")
	button.Position = UDim2.new(0, 15, 0, y)
	button.Size = UDim2.new(1, -30, 0, 43)
	button.BackgroundColor3 = BG
	button.BackgroundTransparency = 0.05
	button.BorderSizePixel = 0
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = main

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(35, 55, 85)
	stroke.Thickness = 1
	stroke.Parent = button

	local dot = Instance.new("Frame")
	dot.Position = UDim2.new(0, 13, 0.5, -4)
	dot.Size = UDim2.new(0, 8, 0, 8)
	dot.BackgroundColor3 = BLUE
	dot.BorderSizePixel = 0
	dot.Parent = button

	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot

	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 31, 0, 0)
	label.Size = UDim2.new(1, -45, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = WHITE
	label.TextSize = 12
	label.Font = Enum.Font.GothamSemibold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	-- Hover
	button.MouseEnter:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(0.15),
			{BackgroundColor3 = Color3.fromRGB(17, 29, 50)}
		):Play()

		TweenService:Create(
			stroke,
			TweenInfo.new(0.15),
			{Color = BLUE}
		):Play()

		TweenService:Create(
			dot,
			TweenInfo.new(0.15),
			{BackgroundColor3 = RED}
		):Play()
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(0.15),
			{BackgroundColor3 = BG}
		):Play()

		TweenService:Create(
			stroke,
			TweenInfo.new(0.15),
			{Color = Color3.fromRGB(35, 55, 85)}
		):Play()

		TweenService:Create(
			dot,
			TweenInfo.new(0.15),
			{BackgroundColor3 = BLUE}
		):Play()
	end)

	-- Click effect
	button.MouseButton1Click:Connect(function()
		local original = button.Size

		TweenService:Create(
			button,
			TweenInfo.new(0.07),
			{Size = UDim2.new(1, -34, 0, 40)}
		):Play()

		TweenService:Create(
			dot,
			TweenInfo.new(0.08),
			{BackgroundColor3 = RED}
		):Play()

		task.wait(0.07)

		TweenService:Create(
			button,
			TweenInfo.new(0.12, Enum.EasingStyle.Back),
			{Size = original}
		):Play()

		task.delay(0.2, function()
			TweenService:Create(
				dot,
				TweenInfo.new(0.15),
				{BackgroundColor3 = BLUE}
			):Play()
		end)
	end)
end

